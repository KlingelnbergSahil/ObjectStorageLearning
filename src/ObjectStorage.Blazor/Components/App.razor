@inject IConfiguration Configuration

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="@BaseHref" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="ObjectStorage.Blazor.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script>
        const normalizeBackupPocUrl = url => {
            if (!url) {
                return url;
            }

            if (url.startsWith('file:///')) {
                return `${window.location.origin}${url.substring('file://'.length)}`;
            }

            if (url.startsWith('/')) {
                return `${window.location.origin}${url}`;
            }

            return url;
        };

        window.backupPoc = {
            uploadFileToUrl: async (inputId, url, contentType) => {
                const input = document.getElementById(inputId);
                if (!input || !input.files || input.files.length === 0) {
                    throw new Error('Choose a backup file first.');
                }

                const file = input.files[0];
                const uploadUrl = normalizeBackupPocUrl(url);
                console.info('Backup POC upload URL:', uploadUrl);

                const response = await fetch(uploadUrl, {
                    method: 'PUT',
                    headers: { 'Content-Type': contentType },
                    body: file
                });

                if (!response.ok) {
                    throw new Error(`Upload failed with HTTP ${response.status}`);
                }

                return { fileName: file.name, size: file.size };
            },
            uploadFileToApi: async (inputId, url, container, objectKey) => {
                const input = document.getElementById(inputId);
                if (!input || !input.files || input.files.length === 0) {
                    throw new Error('Choose a backup file first.');
                }

                const file = input.files[0];
                const formData = new FormData();
                formData.append('File', file, file.name);
                formData.append('Container', container);
                formData.append('ObjectKey', objectKey);

                const uploadUrl = normalizeBackupPocUrl(url);
                console.info('Backup POC upload URL:', uploadUrl);

                const response = await fetch(uploadUrl, {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) {
                    throw new Error(`Upload failed with HTTP ${response.status}`);
                }

                return { fileName: file.name, size: file.size };
            },
            uploadPbmBundleToApi: async (inputId, url, backupName) => {
                const input = document.getElementById(inputId);
                if (!input || !input.files || input.files.length === 0) {
                    throw new Error('Choose a PBM bundle file first.');
                }

                const file = input.files[0];
                const formData = new FormData();
                formData.append('File', file, file.name);
                formData.append('BackupName', backupName);

                const uploadUrl = normalizeBackupPocUrl(url);
                console.info('Backup POC upload URL:', uploadUrl);

                const response = await fetch(uploadUrl, {
                    method: 'POST',
                    body: formData
                });

                const body = await response.text();
                if (!response.ok) {
                    throw new Error(body || `Upload failed with HTTP ${response.status}`);
                }

                return body;
            },
            openUrl: url => window.open(normalizeBackupPocUrl(url), '_blank', 'noopener,noreferrer')
        };
    </script>
</body>

</html>

@code {
    private string BaseHref
    {
        get
        {
            string? pathBase =
                Configuration["PathBase"];

            if (string.IsNullOrWhiteSpace(pathBase) ||
                pathBase == "/")
            {
                return "/";
            }

            return pathBase.TrimEnd('/') + "/";
        }
    }
}
